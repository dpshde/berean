---
import "../styles/search.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Berean</title>
    <meta
      name="description"
      content="Search the Berean Standard Bible by topic, passage, or phrase. Polar questions get a yes or no; everything else gets the verses."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("berean-theme");
          const theme = saved === "dark" || saved === "light" ? saved : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <main class="shell">
      <header class="header">
        <div class="title-group">
          <h1 class="title">Berean</h1>
          <p class="subtitle">BSB · Jev zoom</p>
        </div>
        <div class="header-actions">
          <button
            id="themeToggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            title="Toggle theme"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 1 0 9.8 9.8z"></path>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="12" y1="2" x2="12" y2="5"></line>
              <line x1="12" y1="19" x2="12" y2="22"></line>
              <line x1="2" y1="12" x2="5" y2="12"></line>
              <line x1="19" y1="12" x2="22" y2="12"></line>
              <line x1="4.9" y1="4.9" x2="7" y2="7"></line>
              <line x1="17" y1="17" x2="19.1" y2="19.1"></line>
              <line x1="17" y1="7" x2="19.1" y2="4.9"></line>
              <line x1="4.9" y1="19.1" x2="7" y2="17"></line>
            </svg>
          </button>
        </div>
      </header>

      <section class="search-box">
        <form id="claimForm">
          <div class="query-row">
            <input
              id="queryInput"
              class="query-input"
              type="text"
              name="claim"
              required
              maxlength="400"
              autocomplete="off"
              spellcheck="false"
              autofocus
              placeholder="Hope, anxiety, loving enemies, or John 3:16…"
              aria-label="Search"
            />
            <button
              id="querySubmit"
              class="query-submit"
              type="submit"
              aria-label="Search"
              title="Search"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </button>
          </div>
        </form>
      </section>

      <div id="statusBar" class="status-bar" aria-live="polite" hidden>
        <div class="search-status"></div>
      </div>

      <div id="resultsWrapper" class="results-wrapper is-empty">
        <section id="results" class="results" aria-live="polite">
          <div class="empty-state-enhanced">
            <p class="empty-state-enhanced__title">Search by topic, passage, or phrase.</p>
            <p class="empty-state-enhanced__hint">
              Try a topic like hope, a phrase like love your enemies, or a passage like
              John 3:16.
            </p>
          </div>
        </section>
      </div>

      <div class="results-footer-shell">
        <footer class="results-footer">
          <p class="health-badge">Berean Standard Bible</p>
        </footer>
      </div>
    </main>
    <script>
      import { statusView } from "../lib/status-view.ts";

      const form = document.getElementById("claimForm");
      const input = document.getElementById("queryInput");
      const submit = document.getElementById("querySubmit");
      const themeToggle = document.getElementById("themeToggle");
      const statusBar = document.getElementById("statusBar");
      const resultsWrapper = document.getElementById("resultsWrapper");
      const results = document.getElementById("results");

      const escapeHtml = (value: string) =>
        value
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");

      if (themeToggle) {
        themeToggle.dataset.theme = document.documentElement.dataset.theme ?? "light";
      }

      themeToggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        themeToggle.dataset.theme = next;
        try {
          localStorage.setItem("berean-theme", next);
        } catch {
          /* ignore quota / private mode */
        }
      });

      const setBusy = (busy: boolean) => {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = busy;
          submit.classList.toggle("is-loading", busy);
          submit.setAttribute("aria-busy", busy ? "true" : "false");
        }
      };

      const showStatus = (html: string) => {
        if (!statusBar) return;
        statusBar.hidden = false;
        statusBar.innerHTML = html;
      };

      const renderEmpty = () => {
        if (resultsWrapper) resultsWrapper.classList.add("is-empty");
        if (results) {
          results.innerHTML = `
            <div class="empty-state-enhanced">
              <p class="empty-state-enhanced__title">Search by topic, passage, or phrase.</p>
              <p class="empty-state-enhanced__hint">
                Try a topic like hope, a phrase like love your enemies, or a passage like
                John 3:16.
              </p>
            </div>`;
        }
      };

      const renderError = (message: string) => {
        showStatus(
          `<div class="search-status"><span class="search-status-badge error-text" role="alert">${escapeHtml(message)}</span></div>`,
        );
        renderEmpty();
      };

      const renderResult = (payload: {
        questionKind?: string;
        verdict?: string | null;
        evidence: { displayRef: string; text: string; relation: string }[];
      }) => {
        const view = statusView({ questionKind: payload.questionKind, verdict: payload.verdict });
        const badge = view.showVerdict
          ? `<span class="search-status-badge search-status-badge--${escapeHtml(payload.verdict ?? "")}">${escapeHtml(view.verdictLabel)}</span>
            <span class="search-status-meta">${escapeHtml(view.verdictMeta)}</span>`
          : `<span class="search-status-meta">${escapeHtml(view.verdictMeta)}</span>`;
        showStatus(`
          <div class="search-status">
            ${badge}
          </div>
        `);
        if (resultsWrapper) resultsWrapper.classList.toggle("is-empty", payload.evidence.length === 0);
        if (!results) return;
        if (payload.evidence.length === 0) {
          results.innerHTML = `
            <div class="empty-state-enhanced">
              <p class="empty-state-enhanced__title">No verse on the beam addressed this.</p>
            </div>`;
          return;
        }
        results.innerHTML = payload.evidence
          .map(
            (verse, index) => `
              <article class="card${index === 0 ? " is-selected" : ""}">
                <cite class="card__ref">${escapeHtml(verse.displayRef)}</cite>
                <p class="card__text">${escapeHtml(verse.text)}</p>
                ${
                  view.showRelations
                    ? `<span class="card__relation card__relation--${escapeHtml(verse.relation)}">${escapeHtml(verse.relation)}</span>`
                    : ""
                }
              </article>`,
          )
          .join("");
      };

      const search = async (query: string) => {
        const claim = query.trim();
        if (!claim) return;
        setBusy(true);
        showStatus(
          '<div class="search-status"><span class="search-status-badge search-status-badge--loading">Searching…</span></div>',
        );
        try {
          const response = await fetch("/api/verdict", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ claim }),
          });
          const payload = (await response.json()) as {
            error?: string;
            questionKind?: string;
            verdict?: string | null;
            evidence?: { displayRef: string; text: string; relation: string }[];
          };
          if (!response.ok || payload.error || !payload.questionKind || !payload.evidence) {
            renderError(payload.error ?? "Search failed.");
            return;
          }
          renderResult({
            questionKind: payload.questionKind,
            verdict: payload.verdict ?? null,
            evidence: payload.evidence,
          });
        } catch (err) {
          renderError(err instanceof Error ? err.message : "Search failed.");
        } finally {
          setBusy(false);
        }
      };

      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (input instanceof HTMLInputElement) void search(input.value);
      });
    </script>
  </body>
</html>
