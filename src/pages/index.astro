---
import "../styles/search.css";
import { judgeClaim } from "../lib/verdict.ts";
import type { ClaimVerdict } from "../lib/types.ts";

const examples = [
  "Jesus is the Word of God",
  "God created the heavens",
  "Love your enemies",
];

let result: ClaimVerdict | null = null;
let error: string | null = null;
let claim = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  claim = String(form.get("claim") ?? "");
  try {
    result = await judgeClaim(claim);
  } catch (err) {
    error = err instanceof Error ? err.message : "The claim could not be judged.";
  }
}

const lens = result?.beam ?? [];
const hasResults = Boolean(result || error);
const verdictLabel = result?.verdict === "yes" ? "Yes" : result ? "No" : "";
const verdictMeta =
  result?.verdict === "yes" ? "supported · BSB" : result ? "not supported · BSB" : "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Berean</title>
    <meta
      name="description"
      content="Ask a claim. Get yes or no from the Berean Standard Bible, then the verses that best support that verdict."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("berean-theme");
          const theme = saved === "dark" || saved === "light" ? saved : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <main class="shell">
      <header class="header">
        <div class="title-group">
          <h1 class="title">Berean</h1>
          <p class="subtitle">BSB · Jev zoom</p>
        </div>
        <div class="header-actions">
          <button
            id="themeToggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            title="Toggle theme"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 1 0 9.8 9.8z"></path>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="12" y1="2" x2="12" y2="5"></line>
              <line x1="12" y1="19" x2="12" y2="22"></line>
              <line x1="2" y1="12" x2="5" y2="12"></line>
              <line x1="19" y1="12" x2="22" y2="12"></line>
              <line x1="4.9" y1="4.9" x2="7" y2="7"></line>
              <line x1="17" y1="17" x2="19.1" y2="19.1"></line>
              <line x1="17" y1="7" x2="19.1" y2="4.9"></line>
              <line x1="4.9" y1="19.1" x2="7" y2="17"></line>
            </svg>
          </button>
        </div>
      </header>

      <section class="search-box">
        <form id="claimForm" method="post">
          <div class="query-row">
            <input
              id="queryInput"
              class="query-input"
              type="text"
              name="claim"
              value={claim}
              required
              maxlength="400"
              autocomplete="off"
              spellcheck="false"
              autofocus
              placeholder="Ask a claim — Jesus is the Word of God…"
              aria-label="Claim"
            />
            <button
              id="querySubmit"
              class="query-submit"
              type="submit"
              aria-label="Judge claim"
              title="Judge claim"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </button>
          </div>
        </form>
        <div class="topic-chips" aria-label="Example claims">
          {examples.map((example) => (
            <button class="topic-chip" type="button" data-claim={example}>
              {example}
            </button>
          ))}
        </div>
      </section>

      <div
        id="statusBar"
        class="status-bar"
        aria-live="polite"
        hidden={!hasResults}
      >
        <div class="search-status">
          {error && (
            <span class="search-status-badge error-text" role="alert">{error}</span>
          )}
          {result && (
            <>
              <span class:list={["search-status-badge", `search-status-badge--${result.verdict}`]}>
                {verdictLabel}
              </span>
              <span class="search-status-meta">{verdictMeta}</span>
            </>
          )}
        </div>
        {lens.length > 0 && (
          <div class="lens" aria-label="Jev zoom beam">
            {lens.map((chip) => (
              <span class:list={["lens-chip", `lens-chip--${chip.kind}`]}>
                {chip.path}
              </span>
            ))}
          </div>
        )}
      </div>

      <div class:list={["results-wrapper", { "is-empty": !result }]}>
        <section class="results" aria-live="polite">
          {!result && !error && (
            <div class="empty-state-enhanced">
              <p class="empty-state-enhanced__title">Ask a claim. Scripture answers.</p>
              <p class="empty-state-enhanced__hint">
                Jev zooms Book → Chapter → Verse with a width-3 beam. Code prints the
                verdict, then the winning leaf verses.
              </p>
            </div>
          )}
          {result && result.evidence.length === 0 && (
            <div class="empty-state-enhanced">
              <p class="empty-state-enhanced__title">No verse on the beam addressed this claim.</p>
            </div>
          )}
          {result?.evidence.map((verse) => (
            <article class="card">
              <cite class="card__ref">{verse.displayRef}</cite>
              <p class="card__text">{verse.text}</p>
              <span class:list={["card__relation", `card__relation--${verse.relation}`]}>
                {verse.relation}
              </span>
            </article>
          ))}
        </section>
      </div>

      <div class="results-footer-shell">
        <footer class="results-footer">
          <p class="health-badge">Berean Standard Bible. Scripture judges the claim.</p>
        </footer>
      </div>
    </main>
    <script>
      const form = document.getElementById("claimForm");
      const input = document.getElementById("queryInput");
      const submit = document.getElementById("querySubmit");
      const themeToggle = document.getElementById("themeToggle");
      const statusBar = document.getElementById("statusBar");

      const syncThemeButton = () => {
        if (!themeToggle) return;
        themeToggle.dataset.theme = document.documentElement.dataset.theme ?? "light";
      };
      syncThemeButton();

      themeToggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        themeToggle.dataset.theme = next;
        try {
          localStorage.setItem("berean-theme", next);
        } catch {
          /* ignore quota / private mode */
        }
      });

      const setLoading = () => {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = true;
          submit.classList.add("is-loading");
          submit.setAttribute("aria-busy", "true");
        }
        if (statusBar) {
          statusBar.hidden = false;
          statusBar.innerHTML =
            '<div class="search-status"><span class="search-status-badge search-status-badge--loading">Judging…</span></div>';
        }
      };

      form?.addEventListener("submit", setLoading);

      for (const chip of document.querySelectorAll("[data-claim]")) {
        chip.addEventListener("click", () => {
          if (!(input instanceof HTMLInputElement) || !(form instanceof HTMLFormElement)) return;
          input.value = chip.getAttribute("data-claim") ?? "";
          if (form.requestSubmit) form.requestSubmit();
          else form.submit();
        });
      }
    </script>
  </body>
</html>
